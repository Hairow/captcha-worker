{
  "name": "captcha-worker-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // Workers Static Assets：托管 public 目录下的前端静态资源
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  // 公开静态变量
  "vars": {
    "API_NAME": "captcha-worker-api"
    // Cloudflare Turnstile 人机验证（登录时使用）
    // - Site Key：公开信息，填入 public/login.html 的 <meta name="turnstile-site-key">
    // - Secret Key：本地开发放 .dev.vars（TURNSTILE_SECRET_KEY），生产用 wrangler secret put
    // 可选：hostname 白名单（逗号分隔），防止 token 被跨站使用
    // "TURNSTILE_HOSTNAMES": "example.com",
    // 可选：覆盖管理员账号（不设置时使用内置演示账号 admin/admin123, demo/demo123）
    // "ADMIN_USERNAME": "admin",
    // "ADMIN_PASSWORD": "admin123"
  }
}
// 敏感变量请放在 .dev.vars（本地开发）或 wrangler secret put（生产），不要在配置里写明文
// 部署环境（生产）
// "env": {
//   "production": {
//     "name": "captcha-worker-api-prod"
//   }
// }
// 绑定 KV 存储示例（启用后需 wrangler kv namespace create 创建）
// "kv_namespaces": [
//   {
//     "binding": "MY_KV",
//     "id": "your-kv-namespace-id"
//   }
// ]