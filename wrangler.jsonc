{
  "name": "captcha-worker-api",
  "main": "src/index.js",
  "compatibility_date": "2026-08-01",
  // Workers Static Assets：托管 public 目录下的前端静态资源
  "assets": {
    "directory": "./public",
    "not_found_handling": "single-page-application",
    "html_handling": "none"
  },
  // KV：滑动验证码 token 存储（跨实例共享 + 按 TTL 自动过期）
  // 创建命令：npx wrangler kv namespace create SLIDE_KV
  // 然后把输出里的 id 填到下方；本地 wrangler dev 会用本地模拟，id 可先占位
  "kv_namespaces": [
    {
      "binding": "SLIDE_KV",
      "id": "captcha"
    }
  ],
  // 公开静态变量
  "vars": {
    "API_NAME": "captcha-worker-api"
    // Cloudflare Turnstile 人机验证（登录时使用）
    // - Site Key：公开信息，填入 public/login.html 的 <meta name="turnstile-site-key">
    // - Secret Key：本地开发放 .dev.vars（TURNSTILE_SECRET_KEY），生产用 wrangler secret put
    // 可选：hostname 白名单（逗号分隔），防止 token 被跨站使用
    // "TURNSTILE_HOSTNAMES": "example.com",
    // 可选：覆盖管理员账号（不设置时使用内置演示账号 admin/admin123, demo/demo123）
    // "ADMIN_USERNAME": "admin",
    // "ADMIN_PASSWORD": "admin123"
  },
  "observability": {
    "enabled": false,
    "head_sampling_rate": 1,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "persist": true,
      "invocation_logs": true
    },
    "traces": {
      "enabled": false,
      "persist": true,
      "head_sampling_rate": 1
    }
  }
}